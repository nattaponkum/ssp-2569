# คัดลอกไฟล์นี้เป็น server/.env แล้วใส่ค่าจริง (ไฟล์ .env อยู่ใน .gitignore ห้าม commit)

# กุญแจลับสำหรับเซ็น JWT อย่างน้อย 32 ตัวอักษร สุ่มด้วยคำสั่ง
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# origin ของ client (Vite dev server) ที่อนุญาตให้เรียก API และส่ง cookie
CLIENT_ORIGIN=http://localhost:5173

# บัญชีผู้ดูแลที่ npm run db:seed สร้างให้ (รหัสผ่านอย่างน้อย 8 ตัวอักษร)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
