# ค่าสำหรับรันด้วย docker compose (production) คัดลอกเป็นไฟล์ .env ที่รากของ repo แล้วแก้ไข
# ห้าม commit ไฟล์ .env (อยู่ใน .gitignore แล้ว) ส่วนการพัฒนาบนเครื่องใช้ server/.env.example

# กุญแจลับสำหรับเซ็น JWT อย่างน้อย 32 ตัวอักษร สุ่มด้วยคำสั่ง
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# URL จริงของเว็บ (ต้องตรงกับที่ผู้ใช้เปิดใน browser ใช้ตรวจ CORS และ CSRF)
# ทดลองบนเครื่องตัวเองใช้ http://localhost:8081
CLIENT_ORIGIN=https://blog.example.com

# บัญชีผู้ดูแลที่ db:seed สร้างให้ (รันครั้งเดียวหลัง deploy ครั้งแรก)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ค่าที่เหลือมีค่าเริ่มต้นแล้ว เปลี่ยนเมื่อจำเป็น
# PORT=8081
# DATABASE_URL=./data/app.sqlite
# UPLOAD_DIR=./uploads
