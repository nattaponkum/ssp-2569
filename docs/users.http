### ทดสอบ API ด้วย VS Code REST Client (คลิก "Send Request" เหนือแต่ละคำขอ)
### ก่อนทดสอบ (บทที่ 6 เป็นต้นไป) ให้รัน npm run db:migrate และ npm run db:seed หนึ่งครั้ง
@baseUrl = http://localhost:8081/api

GET {{baseUrl}}/hello

### อ่านผู้ใช้ทั้งหมด
GET {{baseUrl}}/users

### อ่านผู้ใช้ id 1
GET {{baseUrl}}/users/1

### สร้างผู้ใช้ ต้องได้ 201 Created
POST {{baseUrl}}/users
Content-Type: application/json

{ "email": "malee@example.com", "name": "มาลี", "lastname": "สุขใจ" }

### แก้ไขบางฟิลด์
PATCH {{baseUrl}}/users/1
Content-Type: application/json

{ "name": "สมชาย (แก้ไข)" }

### ลบผู้ใช้ ต้องได้ 204 No Content
DELETE {{baseUrl}}/users/2

### ส่งข้อมูลไม่ครบ ต้องได้ 400
POST {{baseUrl}}/users
Content-Type: application/json

{ "email": "malee@example.com" }

### ผู้ใช้ที่ไม่มีอยู่ ต้องได้ 404
GET {{baseUrl}}/users/999
